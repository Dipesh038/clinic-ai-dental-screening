# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.venv/

backend/.venv/
__pycache__/

# Trained YOLO weights (best.pt) ARE committed on purpose: the deployed Render
# backend builds straight from this git checkout with no other way to fetch
# the model, so ignoring it here means production silently runs with no AI
# model at all (every prediction returns nothing, for every image).

