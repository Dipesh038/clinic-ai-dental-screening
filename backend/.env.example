# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=

# Secret used to sign/verify JWT auth tokens
JWT_SECRET=

# Cloudinary connection URL (image upload/storage)
CLOUDINARY_URL=

# Set to false only for local http dev; leave unset/true in production (https)
COOKIE_SECURE=true

# Frontend origin allowed to call this API with credentials
FRONTEND_ORIGIN=http://localhost:3000
